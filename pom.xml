<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.aftsmp</groupId>
    <artifactId>infinitefish-geyser-extension</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>InfiniteFishing Geyser Extension</name>
    <description>Shows InfiniteFishing minigame progress bars as a Bedrock boss bar</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Match your Geyser version exactly. Check yours with /geyser version -->
        <geyser.version>2.3.0-SNAPSHOT</geyser.version>
    </properties>

    <repositories>
        <!-- Primary OpenCollab repo (releases + snapshots merged) -->
        <repository>
            <id>opencollab-releases</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
        <!-- Separate snapshot repo needed for *-SNAPSHOT artifacts -->
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <!--
            JitPack — Geyser core pulls in several git-commit-hash-versioned
            deps (com.github.GeyserMC.Protocol, com.github.GeyserMC:MCAuthLib,
            com.github.geysermc:mcprotocollib) that only exist on JitPack.
        -->
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
        <!-- Netty incubator snapshots (io_uring transport) -->
        <repository>
            <id>netty-snapshots</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Geyser public API — always provided, never shaded -->
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>api</artifactId>
            <version>${geyser.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Geyser Core — needed to cast GeyserConnection → GeyserSession and
            reach the internal Netty channel.  All transitive deps are also
            provided at runtime by Geyser itself, so we exclude the ones that
            are git-hash versioned (Maven can't resolve those from any public
            repo reliably — they're only needed at runtime inside Geyser).
        -->
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>core</artifactId>
            <version>${geyser.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- git-hash JitPack deps — present inside Geyser at runtime, skip at compile -->
                <exclusion>
                    <groupId>com.github.GeyserMC.Protocol</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.GeyserMC</groupId>
                    <artifactId>MCAuthLib</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.geysermc</groupId>
                    <artifactId>mcprotocollib</artifactId>
                </exclusion>
                <!-- Netty incubator io_uring — native lib, not needed to compile -->
                <exclusion>
                    <groupId>io.netty.incubator</groupId>
                    <artifactId>netty-incubator-transport-native-io_uring</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            CloudburstMC Bedrock protocol — provides BossEventPacket, SetTitlePacket, etc.
            This IS published to opencollab under org.cloudburstmc.protocol, which is
            the stable coordinate (as opposed to the JitPack git-hash variant Geyser
            uses internally). It's provided at runtime by Geyser, so scope=provided.
        -->
        <dependency>
            <groupId>org.cloudburstmc.protocol</groupId>
            <artifactId>bedrock-codec</artifactId>
            <version>3.0.0.Beta5-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>io.netty.incubator</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.cloudburstmc.protocol</groupId>
            <artifactId>bedrock-connection</artifactId>
            <version>3.0.0.Beta5-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>io.netty.incubator</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <!-- Single-jar output, nothing to shade since all deps are provided -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Geyser-Extension-Main>io.github.aftsmp.ifgeyser.InfiniteFishingExtension</Geyser-Extension-Main>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
